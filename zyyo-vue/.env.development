# 开发环境变量
# 后端接口前缀（经 vite proxy 转发到本地 Spring Boot）
VITE_API_BASE_URL=/api
# 后端绝对地址（豆包浏览器对同一 host 的连接池存在挂起 bug：
# 页面内第 3 个及以后的 XHR/fetch 会永远 pending，直连 8080 可绕过）
VITE_API_HOST=http://localhost:8080
# 是否使用本地 Mock 数据（true=前端先用假数据跑通页面；false=请求真实后端）
VITE_USE_MOCK=false
# 3D 模型地址（开发环境走后端 uploads 代理；文件位于 leo-server/uploads/models/hero-model.glb）
VITE_MODEL_URL=/uploads/models/hero-model.glb
